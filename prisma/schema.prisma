generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
}

enum Goal {
  FAT_LOSS
  MAINTENANCE
  MUSCLE_GAIN
}

enum Experience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AppMode {
  GUIDED
  ADVANCED
}

enum TdeeCalculationMode {
  COEFFICIENT
  ADDITIVE
}

enum TdeeConfidence {
  HIGH
  MEDIUM
  LOW
}

enum InsightStatus {
  NEW
  SEEN
  RESOLVED
}

enum InsightCategory {
  NUTRITION
  WEIGHT
  SLEEP
  ADHERENCE
  TRAINING
}

enum SupplementType {
  CREATINE
  BETA_ALANINE
}

enum SupplementProtocol {
  LOADING
  STEADY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile        Profile?
  dietPlans      DietPlan[]
  foodLogs       FoodLog[]
  waterLogs      WaterLog[]
  healthDailySummaries HealthDailySummary[]
  physicalActivityLogs PhysicalActivityLog[]
  mealPhotoEstimates MealPhotoEstimate[]
  bodyPhotos     BodyPhoto[]
  trainingPlans  TrainingPlan[]
  supplementPlans SupplementPlan[]
  weeklyCheckins WeeklyCheckin[]
  bodyCompositionSnapshots BodyCompositionSnapshot[]
  insights       CoachInsight[]
  recipes        Recipe[]
  sessions       Session[]
  foodPreferences FoodPreference[]
  customFoods    Food[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Profile {
  id                 String     @id @default(cuid())
  userId             String     @unique @map("user_id")
  sex                Sex
  age                Int
  heightCm           Float      @map("height_cm")
  weightKg           Float      @map("weight_kg")
  neckCm             Float?     @map("neck_cm")
  waistCm            Float?     @map("waist_cm")
  hipCm              Float?     @map("hip_cm")
  goal               Goal
  activityFactor     Float      @map("activity_factor")
  experience         Experience
  restrictions       String[]
  allergies          String[]
  dislikedFoods      String[]   @map("disliked_foods")
  medicalConditions  String[]   @map("medical_conditions")
  dietPreference     String?    @map("diet_preference")
  mode               AppMode
  targetCalories     Int?       @map("target_calories")
  calorieDeficitKcal Int?       @map("calorie_deficit_kcal")
  proteinPerKg       Float?     @map("protein_per_kg")
  fatPerKg           Float?     @map("fat_per_kg")
  carbsPerKg         Float?     @map("carbs_per_kg")
  mealsPerDay        Int        @default(4) @map("meals_per_day")
  fiberTargetG       Float?     @map("fiber_target_g")
  sodiumLimitMg      Float?     @map("sodium_limit_mg")
  calciumTargetMg    Float?     @map("calcium_target_mg")
  ironTargetMg       Float?     @map("iron_target_mg")
  magnesiumTargetMg  Float?     @map("magnesium_target_mg")
  potassiumTargetMg  Float?     @map("potassium_target_mg")
  zincTargetMg       Float?     @map("zinc_target_mg")
  vitaminCTargetMg   Float?     @map("vitamin_c_target_mg")
  vitaminDTargetMcg  Float?     @map("vitamin_d_target_mcg")
  vitaminB12TargetMcg Float?    @map("vitamin_b12_target_mcg")
  waterPreference     String     @default("medium") @map("water_preference")
  tdeeCalculationMode TdeeCalculationMode @default(COEFFICIENT) @map("tdee_calculation_mode")
  tdeeConfidence      TdeeConfidence      @default(MEDIUM) @map("tdee_confidence")
  tdeeAdjustmentKcal  Int                 @default(0) @map("tdee_adjustment_kcal")
  targetWeightKg      Float?              @map("target_weight_kg")
  targetWaistCm       Float?              @map("target_waist_cm")
  targetBodyFatPct    Float?              @map("target_body_fat_pct")
  targetDate          DateTime?           @map("target_date")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Food {
  id             String   @id @default(cuid())
  name           String
  category       String
  kcalPer100g    Float    @map("kcal_per_100g")
  proteinPer100g Float    @map("protein_per_100g")
  carbsPer100g   Float    @map("carbs_per_100g")
  fatPer100g     Float    @map("fat_per_100g")
  fiberPer100g   Float?   @map("fiber_per_100g")
  sodiumPer100g  Float?   @map("sodium_per_100g")
  calciumPer100g Float?   @map("calcium_per_100g")
  ironPer100g    Float?   @map("iron_per_100g")
  magnesiumPer100g Float? @map("magnesium_per_100g")
  potassiumPer100g Float? @map("potassium_per_100g")
  zincPer100g    Float?   @map("zinc_per_100g")
  vitaminCPer100g Float?  @map("vitamin_c_per_100g")
  vitaminDPer100g Float?  @map("vitamin_d_per_100g")
  vitaminB12Per100g Float? @map("vitamin_b12_per_100g")
  pricePerKg      Float?   @map("price_per_kg")
  source         String   @default("Seed ShapeOS")
  createdByUserId String?  @map("created_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  dietItems DietMealItem[]
  foodLogs  FoodLogItem[]
  recipeItems RecipeItem[]
  preferences FoodPreference[]

  @@index([name])
  @@index([createdByUserId])
  @@map("food")
}

model FoodPreference {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  foodId     String   @map("food_id")
  isFavorite Boolean  @default(false) @map("is_favorite")
  isBlocked  Boolean  @default(false) @map("is_blocked")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId, isFavorite])
  @@index([userId, isBlocked])
  @@map("food_preferences")
}

model DietPlan {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  name            String
  goal            Goal
  targetCalories  Int      @map("target_calories")
  targetProteinG  Float    @map("target_protein_g")
  targetCarbsG    Float    @map("target_carbs_g")
  targetFatG      Float    @map("target_fat_g")
  targetFiberG    Float?   @map("target_fiber_g")
  sodiumLimitMg   Float?   @map("sodium_limit_mg")
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals DietMeal[]

  @@map("diet_plans")
}

model DietMeal {
  id         String @id @default(cuid())
  dietPlanId String @map("diet_plan_id")
  name       String
  order      Int
  macroShare Json?

  dietPlan DietPlan       @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  items    DietMealItem[]

  @@map("diet_meals")
}

model DietMealItem {
  id         String  @id @default(cuid())
  mealId     String  @map("meal_id")
  foodId     String  @map("food_id")
  grams      Float
  isFixed    Boolean @default(false) @map("is_fixed")
  isBlocked  Boolean @default(false) @map("is_blocked")

  meal DietMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food     @relation(fields: [foodId], references: [id])

  @@map("diet_meal_items")
}

model FoodLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items FoodLogItem[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("food_logs")
}

model FoodLogItem {
  id        String @id @default(cuid())
  foodLogId String @map("food_log_id")
  foodId    String @map("food_id")
  mealName  String @map("meal_name")
  grams     Float

  foodLog FoodLog @relation(fields: [foodLogId], references: [id], onDelete: Cascade)
  food    Food    @relation(fields: [foodId], references: [id])

  @@map("food_log_items")
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime
  amountMl  Int      @map("amount_ml")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_logs")
}

model HealthDailySummary {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  date                DateTime
  steps               Int?
  activeEnergyKcal    Float?   @map("active_energy_kcal")
  restingEnergyKcal   Float?   @map("resting_energy_kcal")
  totalEnergyKcal     Float?   @map("total_energy_kcal")
  workoutMinutes      Int?     @map("workout_minutes")
  sleepMinutes        Int?     @map("sleep_minutes")
  restingHeartRateBpm Int?     @map("resting_heart_rate_bpm")
  averageHeartRateBpm Int?     @map("average_heart_rate_bpm")
  source              String   @default("apple_health")
  syncedAt            DateTime @default(now()) @map("synced_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("health_daily_summaries")
}

model PhysicalActivityLog {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  date            DateTime
  activityKey     String   @map("activity_key")
  name            String
  met             Float
  durationMinutes Int      @map("duration_minutes")
  distanceKm      Float?   @map("distance_km")
  averageSpeedKmh Float?   @map("average_speed_kmh")
  caloriesKcal    Float    @map("calories_kcal")
  conservativeCaloriesKcal Float? @map("conservative_calories_kcal")
  confidenceFactor Float?  @map("confidence_factor")
  countsTowardTdee Boolean @default(true) @map("counts_toward_tdee")
  intensity       String?
  note            String?
  source          String   @default("manual_met")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("physical_activity_logs")
}

model TrainingPlan {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  name           String
  sourceFileName String?  @map("source_file_name")
  sourceMimeType String?  @map("source_mime_type")
  sourceData     Bytes?   @map("source_data")
  rawResult      Json?    @map("raw_result")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  days TrainingDay[]

  @@index([userId, isActive])
  @@map("training_plans")
}

model TrainingDay {
  id        String  @id @default(cuid())
  planId    String  @map("plan_id")
  name      String
  focus     String?
  order     Int
  notes     String?

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises TrainingExercise[]

  @@index([planId, order])
  @@map("training_days")
}

model TrainingExercise {
  id              String  @id @default(cuid())
  dayId           String  @map("day_id")
  name            String
  muscleGroup     String? @map("muscle_group")
  sets            String?
  reps            String?
  restSeconds     Int?    @map("rest_seconds")
  loadInstruction String? @map("load_instruction")
  notes           String?
  order           Int

  day TrainingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  logs TrainingExerciseLog[]

  @@index([dayId, order])
  @@map("training_exercises")
}

model TrainingExerciseLog {
  id          String   @id @default(cuid())
  exerciseId  String   @map("exercise_id")
  userId      String   @map("user_id")
  date        DateTime
  setsDone    Int?     @map("sets_done")
  repsDone    String?  @map("reps_done")
  loadKg      Float?   @map("load_kg")
  rpe         Float?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  exercise TrainingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([exerciseId, date])
  @@map("training_exercise_logs")
}

model MealPhotoEstimate {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  mealName        String?  @map("meal_name")
  description     String?
  imageMimeType   String?  @map("image_mime_type")
  estimatedKcal   Float?   @map("estimated_kcal")
  estimatedProteinG Float? @map("estimated_protein_g")
  estimatedCarbsG Float?   @map("estimated_carbs_g")
  estimatedFatG   Float?   @map("estimated_fat_g")
  confidence      String?
  rawResult       Json?    @map("raw_result")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("meal_photo_estimates")
}

model SupplementPlan {
  id          String             @id @default(cuid())
  userId      String             @map("user_id")
  type        SupplementType
  protocol    SupplementProtocol @default(STEADY)
  name        String
  dailyDoseG  Float              @map("daily_dose_g")
  startedAt   DateTime           @map("started_at")
  isActive    Boolean            @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs SupplementLog[]
  periods SupplementUsagePeriod[]

  @@index([userId, isActive])
  @@map("supplement_plans")
}

model SupplementLog {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  date      DateTime
  doseG     Float    @map("dose_g")
  createdAt DateTime @default(now()) @map("created_at")

  plan SupplementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, date])
  @@index([planId, date])
  @@map("supplement_logs")
}

model SupplementUsagePeriod {
  id          String   @id @default(cuid())
  planId      String   @map("plan_id")
  startDate   DateTime @map("start_date")
  endDate     DateTime? @map("end_date")
  dailyDoseG  Float    @map("daily_dose_g")
  adherencePct Float   @default(100) @map("adherence_pct")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  plan SupplementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, startDate])
  @@map("supplement_usage_periods")
}

model WeeklyCheckin {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  weekStart       DateTime @map("week_start")
  averageWeightKg Float    @map("average_weight_kg")
  waistCm         Float?   @map("waist_cm")
  adherencePct    Float    @map("adherence_pct")
  hunger          Int
  energy          Int
  sleep           Int
  trainingDone    Boolean  @map("training_done")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyPhotos BodyPhoto[]

  @@index([userId, weekStart])
  @@map("weekly_checkins")
}

model BodyPhoto {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  weeklyCheckinId String @map("weekly_checkin_id")
  fileName       String   @map("file_name")
  imageMimeType  String   @map("image_mime_type")
  imageData      Bytes    @map("image_data")
  pose           String?
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyCheckin WeeklyCheckin @relation(fields: [weeklyCheckinId], references: [id], onDelete: Cascade)

  @@index([userId, weeklyCheckinId])
  @@map("body_photos")
}

model BodyCompositionSnapshot {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  source         String
  measuredAt     DateTime @default(now()) @map("measured_at")
  weightKg       Float    @map("weight_kg")
  neckCm         Float?   @map("neck_cm")
  waistCm        Float?   @map("waist_cm")
  hipCm          Float?   @map("hip_cm")
  bodyFatPct     Float?   @map("body_fat_pct")
  leanMassKg     Float?   @map("lean_mass_kg")
  fatMassKg      Float?   @map("fat_mass_kg")
  limitation     String?
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt])
  @@map("body_composition_snapshots")
}

model CoachInsight {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  trigger   String
  priority  Int
  status    InsightStatus   @default(NEW)
  category  InsightCategory
  message   String
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, priority])
  @@map("coach_insights")
}

model Recipe {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  name        String
  servings    Int
  instructions String?
  createdAt   DateTime @default(now()) @map("created_at")

  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id       String @id @default(cuid())
  recipeId String @map("recipe_id")
  foodId   String @map("food_id")
  grams    Float

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id])

  @@map("recipe_items")
}
